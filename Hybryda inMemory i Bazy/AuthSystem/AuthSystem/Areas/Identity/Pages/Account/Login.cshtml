@page
@model LoginModel

@{
    ViewData["Title"] = "Zaloguj się";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="login-container">
    <div class="login-box">
        <h2>Zaloguj się teraz</h2>
        <p>Jeśli nie masz konta, <a asp-page="./Register">załóż nowe konto.</a></p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label for="email">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" style="border-radius:64px;" />

                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group password-container">
                <label for="password">Hasło</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="**********" style="border-radius:64px;" />

                <span class="toggle-password" style=""><i class="fa fa-eye"></i></span>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div>
                <button id="login-submit" type="submit" class="btn btn-lg btn-primary" style="background-color:#E1528C; color:white; border:none; border-radius:64px; padding:10px 30px; font-size: 20px;">Zaloguj się</button>
            </div>

            <div class="checkbox mb-3">
                <label class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    Zapamiętaj mnie
                </label>
            </div>

            <p><a asp-page="./ForgotPassword">Nie pamiętasz hasła?</a></p>
            <p><a asp-page="./ResendEmailConfirmation">Wyślij ponownie e-mail z potwierdzeniem</a></p>
        </form>
    </div>
    <div class="login-image"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loginForm = document.getElementById('account'); // Upewnij się, że id Twojego formularza to 'account'
            if (loginForm) {
                loginForm.addEventListener('submit', function(event) {
                    event.preventDefault();
                    const emailInput = document.getElementById('Input_Email'); // Upewnij się, że id pola email to 'Input_Email'
                    const passwordInput = document.getElementById('Input_Password'); // Upewnij się, że id pola hasło to 'Input_Password'
                    const errorContainer = document.getElementById('login-error'); // Opcjonalny element do wyświetlania błędów

                    if (!emailInput || !passwordInput) {
                        console.error('Nie znaleziono pól email lub hasło.');
                        return;
                    }

                    const email = emailInput.value;
                    const password = passwordInput.value;

                    fetch('/api/auth/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ username: email, password: password })
                    })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            return response.json().then(data => {
                                throw new Error(data.message || 'Nieprawidłowa próba logowania.');
                            });
                        }
                    })
                    .then(data => {
                        if (data.redirectUrl) {
                            window.location.href = data.redirectUrl;
                        } else {
                            console.log('Pomyślnie zalogowano, brak adresu przekierowania.');
                            window.location.href = '/'; // Domyślne przekierowanie
                        }
                        if (data.token) {
                            localStorage.setItem('authToken', data.token); // Opcjonalnie zapisz token
                        }
                        // Po przekierowaniu nie trzeba nic więcej robić tutaj
                    })
                    .catch(error => {
                        console.error('Błąd logowania:', error);
                        if (errorContainer) {
                            errorContainer.textContent = error.message;
                        } else {
                            alert(error.message); // Pokaż alert, jeśli nie ma kontenera na błędy
                        }
                    });
                });
            } else {
                console.error('Nie znaleziono formularza logowania o id "account".');
            }
        });
    </script>
}
