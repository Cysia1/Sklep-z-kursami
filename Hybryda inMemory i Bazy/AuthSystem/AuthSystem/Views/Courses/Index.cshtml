@model List<AuthSystem.Models.CoursesItemViewModel>
@using AuthSystem.Entities;

@{
    ViewData["Title"] = "Nasze kursy";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="d-flex justify-content-center mb-4">
        <a href="@Url.Action("Create", "Courses")" class="btn btn-success mx-2">Dodaj kurs</a>
    </div>

    <div class="row">
        <aside class="col-md-3"> 
            <h4>Filtruj kursy</h4>
            <form method="get" action="/Courses/Index">
                <div class="mb-3">
                    <label class="form-label">Nazwa kursu</label>
                    <input type="text" name="name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Typ kursu</label>
                    <select name="courseType" class="form-select">
                        <option value="">Wszystkie</option>
                        @foreach (var type in Html.GetEnumSelectList<Database.CourseType>())
                        {
                            <option value="@type.Value">@type.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Cena minimalna</label>
                    <input type="number" name="minPrice" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Cena maksymalna</label>
                    <input type="number" name="maxPrice" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Filtruj</button>
            </form>
        </aside>

        <section class="col-md-9">
            <div class="row mt-4">
                @foreach (var course in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                <img src="@course.Thumbnail" style="width: 100%; object-fit: contain;" alt="@course.CourseName">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@course.CourseName</h5>
                                <p class="card-text">Typ: @course.CourseType</p>
                                <p class="card-text">Cena: @course.CoursePrice zł</p>
                                <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="btn btn-primary">Opis</a>
                                <a href="@Url.Action("Edit", "Courses", new { id = course.CourseId })" class="btn btn-warning ml-2">Edytuj</a>
                                <a href="@Url.Action("Delete", "Courses", new { id = course.CourseId })" class="btn btn-danger ml-2">Usuń</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />