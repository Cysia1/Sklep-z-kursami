@model AuthSystem.Models.CoursesDetailViewModel
@{
    ViewData["Title"] = @Model.CourseName;
}
<h1>@Model.CourseName</h1>
<div class="row">
    <div class="col-md-6">
        <div class="carousel-container">
            <div class="carousel-images">
                <img src="@Model.Thumbnail" class="carousel-image" alt="@Model.CourseName" />
                <img src="@Model.Thumbnail" class="carousel-image" alt="@Model.CourseName" />
                <img src="@Model.Thumbnail" class="carousel-image" alt="@Model.CourseName" />
          
            </div>
            <button class="carousel-btn prev" onclick="moveSlide(-1)">&#10094;</button>
            <button class="carousel-btn next" onclick="moveSlide(1)">&#10095;</button>
        </div>
    </div>
    <div class="col-md-6">
        <h3>Typ kursu: @Model.Thumbnail</h3>
        <p>Opis kursu: @Model.CourseDescription</p>
        <p>Cena zakupu: @Model.CoursePrice</p>
        <a href="@Url.Action("Index", "Courses")" class="btn btn-secondary">Powrót</a>

    </div>
</div>
<style>
    .carousel-container {
        position: relative;
        max-width: 500px;
        height: 350px;
        overflow: hidden;
    }
    .carousel-images {
        display: flex;
        transition: transform 0.5s ease-in-out;
    }
    .carousel-image {
        width: 500px; 
        height: 350px; 
        object-fit: fill; 
        display: block;
    }
    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        padding: 10px;
        font-size: 18px;
        cursor: pointer;
        z-index: 10;
    }
    .prev {
        left: 10px;
    }

    .next {
        right: 10px;
    }
</style>
<script>
    let currentIndex = 0;
    function moveSlide(step) {
        const images = document.querySelectorAll('.carousel-image');
        currentIndex += step;
        if (currentIndex >= images.length) {
            currentIndex = 0;
        } else if (currentIndex < 0) {
            currentIndex = images.length - 1;
        }
        const newTransformValue = -currentIndex * 100;
        document.querySelector('.carousel-images').style.transform = `translateX(${newTransformValue}%)`;
    }
</script>
