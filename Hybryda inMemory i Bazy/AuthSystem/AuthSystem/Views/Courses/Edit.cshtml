@model AuthSystem.Models.CoursesDetailViewModel

<h2>Edytuj Kurs</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="CourseId" />

    <div class="form-group">
        <label asp-for="CourseName" class="control-label">Nazwa</label>
        <input asp-for="CourseName" class="form-control" />
        <span asp-validation-for="CourseName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourseType" class="control-label">Typ</label>
        <input asp-for="CourseType" class="form-control" />
        <span asp-validation-for="CourseType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CourseDescription" class="control-label">Opis</label>
        <input asp-for="CourseDescription" class="form-control" />
        <span asp-validation-for="CourseDescription" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CoursePrice" class="control-label">Cena za dzień</label>
        <input asp-for="CoursePrice" class="form-control" />
        <span asp-validation-for="CoursePrice" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Thumbnail" class="control-label">Obraz 1</label>
        <input type="file" name="Thumbnail" class="form-control" />
        <span asp-validation-for="Thumbnail" class="text-danger"></span>
    </div>



    <div class="d-flex justify-content-center mb-4">
        <input type="submit" value="Potwierdź zmiany" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary ml-4">Powrót do Listy</a>
    </div>
</form>
