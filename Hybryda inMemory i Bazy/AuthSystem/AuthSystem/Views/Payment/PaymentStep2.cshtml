@{
    ViewData["Title"] = "Rozliczenie płatności";
}

<div class="container py-5">
    <div class="row">
        <!-- Formularz płatności -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header custom-header">
                    <h4 class="mb-0">Rozliczenie</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Payment" asp-action="Confirm" method="post">
                        <div class="mb-3">
                            <label for="cardNumber" class="form-label">Numer Karty*</label>
                            <input type="text" id="cardNumber" name="cardNumber" class="form-control" required placeholder="1234 5678 9012 3456" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="expiryDate" class="form-label">Data Ważności Karty*</label>
                                <input type="text" id="expiryDate" name="expiryDate" class="form-control" required placeholder="MM/RR" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="cvv" class="form-label">CVV/CVC (3 cyfry)*</label>
                                <input type="text" id="cvv" name="cvv" class="form-control" required placeholder="123" />
                            </div>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="saveCard" name="saveCard">
                            <label class="form-check-label" for="saveCard">Zapisz moje dane płatnicze na przyszłość</label>
                        </div>
                        <!-- Przycisk do włączenia pop-upu -->
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop" style="background-color: #E1528C; color: white; padding: 10px 20px; border-radius: 20px; text-decoration: none;">
                            Złóż zamówienie
                        </button>

                        <!--Okno pop-upu -->
                        <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
                                <div class="modal-content" style="border-radius: 15px; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
                                    <div class="modal-header" style="border-bottom: none; padding-top: 30px; padding-left: 30px; padding-right: 30px;">
                                        <h1 class="modal-title fs-5" id="staticBackdropLabel" style="color: #555; font-weight: bold;">Dziękujemy za zakup kursu!</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body" style="padding-left: 30px; padding-right: 30px; color: #777; font-size: 0.9rem;">
                                        <div style="display: flex; justify-content: center; margin-bottom: 20px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 16 16" style="fill: #fff; background-color: #A076F2; border-radius: 50%; padding: 3px;">
                                                <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z" />
                                            </svg>
                                        </div>
                                        Na podany adres email wysłaliśmy potwierdzenie zakupu kursu.
                                    </div>
                                    <div class="modal-footer" style="border-top: none; padding: 30px; display: flex; justify-content: center;">
                                        <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal" style="color: #777; border-color: #ddd; padding: 10px 20px; border-radius: 25px; font-size: 0.9rem;">Sprawdź szczegóły zamówienia</button>
                                       <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index"> 
                                         <button  type="button" class="btn btn-primary ms-2" style="background-color: #E1528C; color: white; padding: 10px 20px; border: none; border-radius: 25px; font-size: 0.9rem;">Powrót do Strony Głównej</button>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Podsumowanie zamówienia -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header custom-header">
                    <h4 class="mb-0">Szczegóły zakupu</h4>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produkt</th>
                                <th>Ilość</th>
                                <th>Kwota</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Kurs 1</td>
                                <td>1</td>
                                <td>200 zł</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-end"><strong>Łącznie</strong></td>
                                <td><strong>200 zł</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
