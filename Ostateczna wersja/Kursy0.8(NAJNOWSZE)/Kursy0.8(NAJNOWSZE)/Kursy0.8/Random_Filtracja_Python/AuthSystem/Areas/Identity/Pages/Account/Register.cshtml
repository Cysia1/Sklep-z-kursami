@page
@model RegisterModel

@{
    ViewData["Title"] = "Załóż konto";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="register-container">
    <div class="register-box">
        <h2>Załóż konto</h2>
        <p>Masz już konto? <a asp-page="./Login">Zaloguj się</a>.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group-row">
                <div class="form-group">
                    <label for="firstName">Imię</label>
                    <input asp-for="Input.FirstName" id="firstName" class="form-control" placeholder="Twoje imię" style="border-radius:64px;"  />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="lastName">Nazwisko</label>
                    <input asp-for="Input.LastName" id="lastName" class="form-control" placeholder="Twoje nazwisko" style="border-radius:64px;" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input asp-for="Input.Email" id="email" class="form-control" placeholder="Twój email" style="border-radius:64px;" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group-row">
                <div class="form-group password-container">
                    <label for="password">Hasło</label>
                    <input asp-for="Input.Password" id="password" type="password" class="form-control" placeholder="******" style="border-radius:64px;"  />
                    <span class="toggle-password"><i class="fa fa-eye"></i></span>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group password-container">
                    <label for="confirmPassword">Potwierdź Hasło</label>
                    <input asp-for="Input.ConfirmPassword" id="confirmPassword" type="password" class="form-control" placeholder="******" style="border-radius:64px;"  />
                    <span class="toggle-password"><i class="fa fa-eye"></i></span>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group checkbox-group">
                <input type="checkbox" id="acceptTerms" required>
                <label for="acceptTerms">Akceptuję  <a asp-controller="Home" asp-action="Statute">Regulamin</a> oraz <a asp-controller="Home" asp-action="Privacy">Politykę Prywatności</a></label>
            </div>

            <button type="submit" class="btn-register">Załóż konto</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
