<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuthLayout</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap">
</head>
<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }</style>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="menu">
                <img src="~/images/logo.png" alt="logo" width="100" style="height: auto;" />


                <a asp-controller="Home" asp-action="Contact">Kontakt</a>

                @if (User.Identity.IsAuthenticated)
                {
                    <partial name="_LoginPartial.cshtml" />
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register">Zarejestruj się</a>
                    <a asp-area="Identity" asp-page="/Account/Login">Zaloguj się</a>
                    <div class="user-icon"><i class="fa fa-user"></i></div>
                }
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid">
        @RenderBody()
    </main>


    <footer style="background-color: #564694; padding: 60px 0; text-align: center;  ">
        @* <div style="font-size: 35px ; margin-bottom: 10px; padding:20px 0; color:white">
            Zapisz się do Subskrypcji i bądź na bieżąco z wszystkimi kursami.
        </div>
        <a href="#" style="background-color: #E1528C; color: white; padding: 10px 20px; border-radius: 20px; text-decoration: none;">Subskrypcja ></a> *@
        <div style="margin-bottom: 20px; font-size: 1.1em;">
            <a asp-controller="Home" asp-action="Privacy" style="color: #f5f5f5; text-decoration: none; margin-right: 20px;">
                Polityka Prywatności
            </a>
            <span style="color: #e0e0e0;">|</span>
            <a asp-controller="Home" asp-action="Statute" style="color: #f5f5f5; text-decoration: none; margin-left: 20px; margin-right: 20px;">Regulamin</a>
            <span style="color: #e0e0e0;">|</span>
            <a asp-controller="Home" asp-action="Contact" style="color: #f5f5f5; text-decoration: none; margin-left: 20px;">Kontakt</a>
        </div>
        <p style="font-size: 1em; color: #bdbdbd; margin-bottom: 0;">
            Wszelkie prawa zastrzeżone &copy; @DateTime.Now.Year SkillHolder
        </p>
    </footer>

    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>