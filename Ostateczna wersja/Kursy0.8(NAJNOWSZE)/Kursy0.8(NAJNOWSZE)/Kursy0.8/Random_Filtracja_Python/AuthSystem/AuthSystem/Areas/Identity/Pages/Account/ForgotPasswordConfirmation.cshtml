@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Potwierdzenie zmiany hasła";
}

<h1 style=" display: flex;
    justify-content: center;
    align-items: flex-start;">
    @ViewData["Title"]
</h1>
<p style=" display: flex; justify-content: center; align-items: flex-start;">
    Na podany adres email wysłaliśmy link do zmiany hasła.
</p>

<p style=" display: flex; justify-content: center; align-items: flex-start;"><a asp-page="./ResendEmailConfirmation">Nie otrzymałeś wiadomości? Wyślij ponownie e-mail z potwierdzeniem</a></p>


<p style=" display: flex; justify-content: center; align-items: flex-start;"><a asp-page="./Login">Powrót do strony logowania</a></p>