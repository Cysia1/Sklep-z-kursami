@{
    ViewData["Title"] = "Płatność Zakończona";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-sm" style="border-radius: 15px; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
                <div class="card-body p-5">
                    <div style="display: flex; justify-content: center; margin-bottom: 20px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 16 16" style="fill: #fff; background-color: #A076F2; border-radius: 50%; padding: 10px;">
                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z" />
                        </svg>
                    </div>
                    <h2 class="mb-4" style="color: #555; font-weight: bold;">Dziękujemy za zakup kursu!</h2>
                    <p class="lead" style="color: #777;">
                        Wybrany przez ciebie kurs został dodany do twojej zakładki "Zakupione kursy".
                        <br />
                        Kliknij w komunikat Witaj!
                    </p>
                    <div class="mt-4">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-lg"
                           style="background-color: #E1528C; color: white; padding: 12px 30px; border: none; border-radius: 30px; font-size: 1rem;">
                            Powrót do Strony Głównej
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>