@model AuthSystem.Models.CoursesDetailViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<AuthSystem.Areas.Identity.Data.ApplicationUser> UserManager
@{
    ViewData["Title"] = @Model.CourseName;
}

@{
    // Pobierz ID aktualnie zalogowanego użytkownika
    var currentUserId = UserManager.GetUserId(User);
}

<div class="container-fluid py-5">
    <h2 class="mb-4" style="text-align: center;">Szczegóły kursu</h2>

    <div class="card shadow-sm border rounded p-5 bg-light" style="max-width: 1200px; margin: 0 auto;">
        <div class="row mb-5">
            <div class="col-md-6 d-flex justify-content-center">
                <div class="upload-main shadow-sm border rounded position-relative d-flex align-items-center justify-content-center bg-white"
                style="width: 100%; max-width: 400px; height: 300px;">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img id="previewImage" src="@Model.ThumbnailUrl" alt="Zdjęcie Kursu"
                        style="max-height: 100%; max-width: 100%; display: block; border-radius: 8px;" />
                    }
                    else
                    {
                        <span style="font-size: 60px; color: #888;">Brak zdjęcia</span>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">Nazwa kursu</label>
                    <div class="form-control rounded-pill text-break" style="border: 1px solid #ced4da; padding: .375rem .75rem;">@Model.CourseName</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Cena</label>
                    <div class="form-control rounded-pill text-break" style="border: 1px solid #ced4da; padding: .375rem .75rem;">@Model.CoursePrice zł</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Typ</label>
                    <div class="form-control rounded-pill text-break" style="border: 1px solid #ced4da; padding: .375rem .75rem;">@Model.CourseType</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Opis kursu</label>
                    <div class="form-control text-break" style="border: 1px solid #ced4da; padding: .375rem .75rem; height: auto; min-height: calc(1.5em + .75rem + 2px);">@Model.CourseDescription</div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border rounded p-4 bg-light mb-4">
            <h4 class="fw-bold mb-3" style="text-align: center;">Zawartość kursu</h4>

            @if (Model.OwnerId == currentUserId || Model.IsPurchased)
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">Link do YouTube</label>

                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <div class="form-control text-break" style="border: 1px solid #ced4da; padding: .375rem .75rem;">@Model.VideoUrl</div>
                        var videoId = System.Text.RegularExpressions.Regex.Match(Model.VideoUrl, @"(?:youtube\.com\/(?:[^\/]+\/[^\/]+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})").Groups[1].Value;
                        if (!string.IsNullOrEmpty(videoId))
                        {
                            var embedUrl = $"https://www.youtube.com/embed/{videoId}";
                            <div class="d-flex justify-content-center mt-3">
                                <div class="shadow-sm border bg-light rounded p-3 w-100" style="max-width: 600px;">
                                    <h6 class="fw-bold text-center mb-3">Podgląd wideo</h6>
                                    <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px;">
                                        <iframe src="@embedUrl" frameborder="0" allowfullscreen
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"></iframe>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mt-2 text-center">Nieprawidłowy link YouTube</div>
                        }
                    }
                    else
                    {
                        <div class="text-muted mb-2">Brak link YouTube </div>
                    }

                    <hr class="my-4" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Plik PDF</label>
                        <div class="d-flex justify-content-center mt-3">
                            <div class="shadow-sm border bg-light rounded p-3 w-100 center" style="max-width: 400px;">
                                <h6 class="fw-bold text-center mb-3">Pobierz kurs w formie pdf-u</h6>
                                @if (Model.PdfAvailable)
                                {
                                    <div class="d-flex justify-content-center mt-4">
                                        <a asp-action="GetPdf" asp-route-id="@Model.CourseId" target="_blank" class="plus-button">↓</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted mb-2">Brak pliku PDF</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-muted p-4">
                    <p>Zawartość kursu odblokuje się po zakupie.</p>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mt-4">

        @if (Model.IsPurchased)
        {
            <button class="btn" disabled style="background-color: #6c757d; color: white; padding: 12px 30px; border-radius: 30px; font-weight: bold;">
                Zakupiono
            </button>
        }
        else if (Model.OwnerId != currentUserId)
        {
            <a asp-action="PaymentStep1"
               asp-controller="Payment"
               asp-route-courseId="@Model.CourseId"
               class="btn"
               style="background-color: #E1528C; color: white; padding: 12px 30px; border-radius: 30px; font-weight: bold;">
                Kup teraz
            </a>
        }

        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill" style="color: #E1528C;">
            &gt; Powrót do listy kursów
        </a>
    </div>
</div>

<style>
    .fw-bold {
        font-weight: bold;
    }

    .rounded-pill {
        border-radius: 50rem;
    }

    .px-4 {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }

    .gap-2 {
        gap: 0.5rem !important;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .py-4 {
        padding-top: 1.5rem !important;
        padding-bottom: 1.5rem !important;
    }

    .col-sm-12 {
        word-break: break-word;
    }

    .col-md-8 {
        flex: 0 0 auto;
        width: 66.66666667%;
    }

    .offset-md-2 {
        margin-left: 16.66666667%;
    }

    .border {
        border: 1px solid #dee2e6 !important;
    }

    .shadow-sm {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    .p-4 {
        padding: 1.5rem !important;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }

    .image-upload-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
        width: 100%;
    }

    .image-preview {
        border: 1px dashed #ccc;
        background-color: #f8f9fa;
        overflow: hidden;
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .image-preview img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .text-muted {
        color: #6c757d !important;
    }

    .fs-1 {
        font-size: 2.5rem !important;
    }

    .d-flex {
        display: flex !important;
    }

    .flex-column {
        flex-direction: column !important;
    }

    .align-items-center {
        align-items: center !important;
    }

    .justify-content-center {
        justify-content: center !important;
    }

    .btn {
        display: inline-block;
        font-weight: 400;
        line-height: 1.5;
        color: #212529;
        text-align: center;
        text-decoration: none;
        vertical-align: middle;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
        background-color: transparent;
        border: 1px solid transparent;
        padding: .375rem .75rem;
        font-size: 1rem;
        border-radius: .25rem;
        transition: color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }

    .btn-primary {
        color: #fff;
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            color: #fff;
            background-color: #0056b3;
            border-color: #0056b3;
        }

    .btn-outline-secondary {
        color: #6c757d;
        border-color: #6c757d;
    }

        .btn-outline-secondary:hover {
            color: #fff;
            background-color: #6c757d;
            border-color: #6c757d;
        }

    .bi {
        display: inline-block;
        font-style: normal;
        font-weight: normal !important;
        font-variant: normal;
        text-transform: none;
        line-height: 1;
        vertical-align: -.125em;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .bi-pencil-square::before {
        content: "\f440";
    }

    .bi-arrow-left-circle::before {
        content: "\f2a8";
    }

    .embed-responsive {
        position: relative;
        display: block;
        width: 100%;
        padding: 0;
        overflow: hidden;
    }

        .embed-responsive::before {
            display: block;
            content: "";
            padding-top: 56.25%;
        }

        .embed-responsive .embed-responsive-item {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .plus-button {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        width: 80px;
        height: 80px;
        border: 2px solid #ccc;
        border-radius: 12px;
        text-decoration: none;
        color: #333;
        background-color: #fff;
        transition: all 0.3s ease-in-out;
        margin-top: 20px; /* odstęp od góry */
    }

        .plus-button:hover {
            border-color: #007bff;
            background-color: #e2f0ff;
            color: #007bff;
        }
</style>

<script>
    let currentIndex = 0;
    function moveSlide(step) {
        const images = document.querySelectorAll('.carousel-image');
        currentIndex += step;
        if (currentIndex >= images.length) {
            currentIndex = 0;
        } else if (currentIndex < 0) {
            currentIndex = images.length - 1;
        }
        const newTransformValue = -currentIndex * 100;
        document.querySelector('.carousel-images').style.transform = `translateX(${newTransformValue}%)`;
    }
</script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
