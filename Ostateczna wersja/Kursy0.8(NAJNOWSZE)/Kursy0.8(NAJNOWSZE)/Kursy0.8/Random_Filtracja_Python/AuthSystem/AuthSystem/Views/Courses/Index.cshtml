@model List<AuthSystem.Models.CoursesItemViewModel>
@using AuthSystem.Entities
@using Microsoft.AspNetCore.Identity
@using AuthSystem.Areas.Identity.Data
@inject UserManager<AuthSystem.Areas.Identity.Data.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Nasze kursy";
    var courseTypes = ViewBag.CourseTypes as List<string>;
    var currentUserId = UserManager.GetUserId(User);
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h1 class="text-center">@ViewData["Title"]</h1>

    <div class="d-flex justify-content-center mb-4">
        <a href="@Url.Action("Create", "Courses")"
           class="btn"
           style="background-color: #E1528C; color: white; padding: 12px 24px; border-radius: 30px; font-weight: bold;">
            Dodaj kurs
        </a>
    </div>

    <div class="row">
        <aside class="col-md-3 filter-panel">
            <div class="p-4 shadow-sm bg-light rounded-4">
                <h4>Filtruj kursy</h4>
                <form method="get" action="/Courses/Index" id="filterForm">
                    <div class="mb-3">
                        <label class="form-label">Nazwa kursu</label>
                        <input type="text" name="name" class="form-control" value="@ViewBag.NameFilter" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Typ kursu</label>
                        <select name="courseType" class="form-select">
                            <option value="">Wszystkie</option>
                            @if (courseTypes != null)
                            {
                                @foreach (var type in courseTypes.Distinct().OrderBy(t => t))
                                {
                                    <option value="@type" selected="@(ViewBag.CourseTypeFilter == type)">@type</option>
                                }
                            }
                        </select>
                    </div>

                    @* Sekcja filtra własności *@
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="mb-3">
                            <label class="form-label">Własność kursu</label>
                            <select name="ownershipFilter" class="form-select" onchange="this.form.submit()">
                                <option value="">Wszystkie kursy</option>
                                <option value="myCourses" selected="@(ViewBag.OwnershipFilter == "myCourses")">Moje kursy</option>
                                <option value="otherCourses" selected="@(ViewBag.OwnershipFilter == "otherCourses")">Kursy innych użytkowników</option>
                            </select>
                        </div>

                        @if (ViewBag.OwnershipFilter == "otherCourses")
                        {
                            <div class="mb-3">
                                <label class="form-label">Status zakupu</label>
                                <select name="purchaseStatusFilter" class="form-select">
                                    <option value="">Wszystkie</option>
                                    <option value="toBuy" selected="@(ViewBag.PurchaseStatusFilter == "toBuy")">Do kupienia</option>
                                    <option value="purchased" selected="@(ViewBag.PurchaseStatusFilter == "purchased")">Zakupione</option>
                                </select>
                            </div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label">Zakres cen</label>
                        <div id="priceSlider"></div>
                        <input type="hidden" name="minPrice" id="minPrice" value="@ViewBag.MinPriceFilter" />
                        <input type="hidden" name="maxPrice" id="maxPrice" value="@ViewBag.MaxPriceFilter" />
                        <div class="d-flex justify-content-between mt-2">
                            <span id="minPriceText">0 zł</span>
                            <span id="maxPriceText">1000 zł</span>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit"
                                class="btn"
                                style="background-color: #E1528C; color: white; border-radius: 30px; font-weight: bold;">
                            Filtruj
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                style="background-color: #E1528C; color: white; border-radius: 30px; font-weight: bold;"
                                onclick="resetFilters()">
                            Resetuj
                        </button>
                    </div>
                </form>
            </div>
        </aside>

        <section class="col-md-9">
            <div class="row mt-4">
                @foreach (var course in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 position-relative">
                            @* DODANO: position-relative do karty *@
                            @if (currentUserId != null && course.OwnerId == currentUserId)
                            {
                                <div class="my-course-badge">Mój kurs</div>
                            }
                            else if (course.IsPurchased)
                            {
                                <div class="purchased-badge">Zakupiono</div>
                            }
                            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                <img src="@course.ThumbnailUrl" style="width: 100%; object-fit: contain;" alt="@course.CourseName">
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title">@course.CourseName</h5>
                                    <p class="card-text">Typ: @course.CourseType</p>
                                    <p class="card-text">Cena: @course.CoursePrice zł</p>
                                </div>
                                <div class="mt-3 d-flex justify-content-between flex-wrap gap-2">
                                    <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="btn"
                                       style="background-color: #8267eb; color: white;">Więcej</a>

                                    @* WARUNKOWE WYŚWIETLANIE PRZYCISKÓW EDYTUJ/USUŃ *@
                                    @if (currentUserId != null && course.OwnerId == currentUserId)
                                    {
                                        <a href="@Url.Action("Edit", "Courses", new { id = course.CourseId })"
                                           class="btn"
                                           style="background-color: #eb772d; color: white;">Edytuj</a>
                                        <a href="@Url.Action("Delete", "Courses", new { id = course.CourseId })"
                                           class="btn"
                                           style="background-color: #E1528C; color: white;">Usuń</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<script>
    function resetFilters() {
        document.getElementById('filterForm').querySelectorAll('input[type=text]').forEach(input => input.value = '');
        document.getElementById('filterForm').querySelector('select[name="courseType"]').value = '';

        const ownershipFilterSelect = document.getElementById('filterForm').querySelector('select[name="ownershipFilter"]');
        if (ownershipFilterSelect) {
            ownershipFilterSelect.value = '';
        }

        slider.noUiSlider.set([0, 1000]);
        document.getElementById('filterForm').submit();
    }
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>
    <script>
        const slider = document.getElementById('priceSlider');
        if (slider) {
            noUiSlider.create(slider, {
                start: [parseFloat('@(ViewBag.MinPriceFilter ?? 0)') || 0, parseFloat('@(ViewBag.MaxPriceFilter ?? 1000)') || 1000],
                connect: true,
                step: 1,
                range: {
                    'min': 0,
                    'max': 1000
                },
                format: {
                    to: value => Math.round(value),
                    from: value => Number(value)
                }
            });

            const minInput = document.getElementById('minPrice');
            const maxInput = document.getElementById('maxPrice');
            const minText = document.getElementById('minPriceText');
            const maxText = document.getElementById('maxPriceText');

            slider.noUiSlider.on('update', function (values) {
                minInput.value = values[0];
                maxInput.value = values[1];
                minText.textContent = values[0] + ' zł';
                maxText.textContent = values[1] + ' zł';
            });
        }
    </script>
}

<style>
    .filter-panel {
        margin-top: -40px;
    }

    .noUi-connect {
        background: #8267eb !important;
    }

    .noUi-handle {
        border: 2px solid #8267eb;
        background: white;
        box-shadow: none;
    }

    .noUi-target {
        border: none;
        background: #f1f1f1;
        border-radius: 8px;
    }

    /* NOWE STYLE DLA OZNACZENIA "MÓJ KURS" */
    .card.position-relative {
        overflow: hidden; /* Upewnia się, że odznaka nie wychodzi poza ramkę karty */
    }

    .my-course-badge {
        position: absolute;
        top: 0;
        right: 0;
        background-color: #8267eb; /* Kolor tła, możesz zmienić */
        color: white;
        padding: 5px 10px;
        font-size: 0.8em;
        font-weight: bold;
        border-bottom-left-radius: 10px; /* Zaokrąglony róg */
        z-index: 10; /* Upewnia się, że jest na wierzchu */
        transform: translate(0%, 0%); /* Drobna korekta pozycji */
        box-shadow: 0 2px 5px rgba(0,0,0,0.2); /* Lekki cień */
        text-align: center;
        /* Możesz dodać rotację, jeśli chcesz efekt wstążki */
        /* transform: rotate(45deg); */
        /* transform-origin: 100% 0%; */
        /* right: -25px; */
        /* top: 15px; */
        /* width: 100px; */
    }

    .purchased-badge {
        position: absolute;
        top: 0;
        right: 0;
        background-color: #eb772d; /* Pomarańczowy kolor */
        color: white;
        padding: 5px 10px;
        font-size: 0.8em;
        font-weight: bold;
        border-bottom-left-radius: 10px;
        z-index: 10;
    }
</style>