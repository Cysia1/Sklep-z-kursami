<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sklep z Kursami</title>


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/AuthSystem.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;400;700&display=swap" rel="stylesheet">
</head>
<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    main {
        margin: 0;
        flex: 1;
        width: 100%;
    }</style>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="logo" width="100" height="auto" class="me-2" />
                    <span class="fw-bold">SkillHolder</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Strona główna</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Kategorie
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @await Component.InvokeAsync("CategoryMenu")
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Kontakt</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <partial name="_LoginPartial.cshtml" />
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="fa fa-user"></i> Zaloguj/Zarejestruj
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <footer style="background-color: #564694; padding: 60px 0; text-align: center; margin-top:auto ">
        <div style="margin-bottom: 20px; font-size: 1.1em;">
            <a asp-controller="Home" asp-action="Privacy" style="color: #f5f5f5; text-decoration: none; margin-right: 20px;">
                Polityka Prywatności
            </a>
            <span style="color: #e0e0e0;">|</span>
            <a asp-controller="Home" asp-action="Statute" style="color: #f5f5f5; text-decoration: none; margin-left: 20px; margin-right: 20px;">Regulamin</a>
            <span style="color: #e0e0e0;">|</span>
            <a asp-controller="Home" asp-action="Contact" style="color: #f5f5f5; text-decoration: none; margin-left: 20px;">Kontakt</a>
        </div>
        <p style="font-size: 1em; color: #bdbdbd; margin-bottom: 0;">
            Wszelkie prawa zastrzeżone &copy; @DateTime.Now.Year SkillHolder
        </p>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>