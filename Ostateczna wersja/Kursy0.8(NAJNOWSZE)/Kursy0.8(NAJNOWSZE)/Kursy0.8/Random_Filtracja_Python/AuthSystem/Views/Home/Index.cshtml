@{
    ViewData["Title"] = "Home Page";
}

@{
    ViewBag.Title = "Strona Główna";
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body id="index-page">

    <div class="hero-section text-center d-flex flex-column justify-content-center align-items-center w-100 min-vh-50">
        <h1>Co my wiemy, to tylko kropla. Czego nie wiemy, to cały ocean. [Isaac Newton]</h1>
        <div class="mt-4">
            <div class="search-btn">
                <i class="fas fa-search"></i>
            </div>
            <p class="mt-2">Wyszukaj kurs</p>
        </div>
    </div>

    <div class="courses-section w-100 py-5 text-center">
        <h2>Poznaj nasze najpopularniejsze kursy</h2>
        <div class="container-fluid px-5">
            <div class="row justify-content-center">
                <div class="col-lg-3 col-md-6 p-3">
                    <div class="course-card">Kurs - zdjęcie / filmik</div>
                </div>
                <div class="col-lg-3 col-md-6 p-3">
                    <div class="course-card">Kurs - zdjęcie / filmik</div>
                </div>
                <div class="col-lg-3 col-md-6 p-3">
                    <div class="course-card">Kurs - zdjęcie / filmik</div>
                </div>
                <div class="col-lg-3 col-md-6 p-3">
                    <div class="course-card">Kurs - zdjęcie / filmik</div>
                </div>
            </div>
        </div>
        <button class="more-btn mt-4">Zobacz więcej ></button>
    </div>

    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
</body>
</html>