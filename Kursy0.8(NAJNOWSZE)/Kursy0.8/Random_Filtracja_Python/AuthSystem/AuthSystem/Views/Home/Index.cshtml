@{
    ViewData["Title"] = "Strona Główna";
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title> 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>
<body id="index-page">

    <section class="hero-section">
        <div class="container-fluid">
            <div class="hero-content text-center">
                <h1>@ViewData["RandomQuoteText"] <br /> [@ViewData["RandomQuoteAuthor"]]</h1>
            

                <div class="search-container">
                    <a href="#" class="search-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" viewBox="0 0 24 24" fill="white">
                            <path d="M15.5 14h-.79l-.28-.27a6.471 6.471 0 001.48-5.34C15.05 5.1 12.42 2.5 9 2.5S2.95 5.1 2.95 8.39c0 3.3 2.63 5.89 5.95 5.89 1.61 0 3.08-.63 4.23-1.76l.27.28v.79l5 4.99 1.49-1.49-4.99-5zm-6.5 0C7 14 5 12 5 9.5S7 5 9.5 5 14 7 14 9.5 12 14 9.5 14z" />
                        </svg>
                    </a>
                    <p class="search-text">Wyszukaj kurs</p>
                </div>
            </div>
        </div>
    </section>

    <div class="courses-section w-100 py-5 text-center">
        <h2 class="section-title">Poznaj nasze najpopularniejsze kursy</h2>
        <div class="container">
            <div class="row justify-content-center">
                @if (ViewBag.PopularCourses != null)
                {
                    @foreach (var course in (List<AuthSystem.Models.CoursesItemViewModel>)ViewBag.PopularCourses)
                    {
                        <div class="col-lg-3 col-md-6 p-3">
                            <div class="course-card">
                                <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                    <img src="@course.ThumbnailUrl" style="width: 100%; object-fit: contain;" alt="@course.CourseName">
                                </div>
                                <div class="overlay">
                                    <p>@course.CourseName</p>
                                    <p>Cena: @course.CoursePrice zł</p>
                                    <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="btn btn-light btn-sm mt-2">Zobacz opis</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Brak dostępnych popularnych kursów.</p>
                }
            </div>
        </div>
        <a href="/Courses?sort=popular" class="more-btn mt-4">Zobacz więcej <span>&#10132;</span></a>
    </div>

</body>
</html>
