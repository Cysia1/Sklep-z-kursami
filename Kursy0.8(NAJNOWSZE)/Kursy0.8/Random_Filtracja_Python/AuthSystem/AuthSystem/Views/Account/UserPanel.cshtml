@using AuthSystem.Entities
@using static AuthSystem.Entities.Database
@model AuthSystem.Models.CoursesDetailViewModel

<div class="container py-5">
    <div class="row">
        <!-- Lista nawigacyjna po lewej -->
        <div class="col-md-3">
            <div class="list-group" id="courseTab" role="tablist">
                <a class="list-group-item list-group-item-action active" id="basic-tab" data-bs-toggle="list" href="#basic" role="tab" style="background-color: #E1528C; color: white;">Ustawienia konta</a>
                <a class="list-group-item list-group-item-action" id="media-tab" data-bs-toggle="list" href="#media" role="tab">Subskrypcja</a>
                <a class="list-group-item list-group-item-action" id="price-tab" data-bs-toggle="list" href="#price" role="tab">Twoje kursy</a>
            </div>
        </div>

        <!-- Sekcje formularza po prawej -->
        <div class="col-md-9">
            <form>
                <div class="tab-content" id="courseTabContent">
                    <!-- Zakładka 1: Ustawienia konta -->
                    <div class="tab-pane fade show active" id="basic" role="tabpanel">
                        <h2 class="mb-3">Ustawienia konta</h2>
                        <p class="mb-4">Tutaj możesz zmienić dane swojego konta i zarządzać swoją subskrypcją.</p>

                        <h5 class="mb-3 fw-bold">Informacje Użytkownika</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <input type="text" class="form-control rounded-pill bg-light" placeholder="Imię">
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control rounded-pill bg-light" placeholder="Nazwisko">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <input type="email" class="form-control rounded-pill bg-light" placeholder="Email">
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control rounded-pill bg-light" placeholder="XXX XXX XXX">
                            </div>
                        </div>

                        <h5 class="mb-3 fw-bold">Zmiana Hasła</h5>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <input type="password" class="form-control rounded-pill bg-light" placeholder="*******************">
                            </div>
                            <div class="col-md-6">
                                <input type="password" class="form-control rounded-pill bg-light" placeholder="*******************">
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn" style="background-color: #E1528C; color: white; padding: 12px 30px; border-radius: 30px; font-size: 18px; font-weight: bold;">Zapisz zmiany</button>
                        </div>
                    </div>

                    <!-- Zakładka 2: Subskrypcja -->
                    <div class="tab-pane fade" id="media" role="tabpanel">
                        <h5 class="mb-3 fw-bold">Subskrypcja</h5>

                        @if (ViewBag.IsSubscriptionActive == true)
                        {
                            <p class="h3">Twoja subskrypcja jest</p>
                            <p class="h3 mb-4 text-success">Aktywna</p>
                        }
                        else
                        {
                            <p class="h3">Nie masz aktywnej subskrypcji</p>
                            <div class="mt-3">
                                <a asp-controller="Subscription" asp-action="Activate" class="btn"
                                   style="background-color: #E1528C; color: white; padding: 12px 30px; border-radius: 30px; font-size: 18px; font-weight: bold;">
                                    Aktywuj Subskrypcję
                                </a>
                            </div>
                        }
                    </div>


                    <!-- Zakładka 3: Twoje kursy -->
                    <div class="tab-pane fade" id="price" role="tabpanel">
                        <h4 class="fw-bold mb-3">Twoje kursy</h4>
                        <p class="text-muted mb-4">Kursy stworzone przez ciebie.</p>

                        <div class="row">
                            @if (ViewBag.RandomUserCourses != null)
                            {
                                @foreach (var course in (List<AuthSystem.Models.CoursesItemViewModel>)ViewBag.RandomUserCourses)
                                {
                                    <div class="col-md-4 mb-4">
                                        <div class="card">
                                            <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                                <img src="@Url.Action("GetThumbnail", "Courses", new { id = course.CourseId })" style="width: 100%; object-fit: contain;" alt="@course.CourseName">
                                            </div>
                                            <div class="card-body">
                                                <h5 class="card-title">@course.CourseName</h5>
                                                <p class="card-text">Typ: @course.CourseType</p>
                                                <p class="card-text">Cena: @course.CoursePrice zł</p>
                                                <a href="@Url.Action("Details", "Courses", new { id = course.CourseId })" class="btn btn-primary">Opis</a>
                                                <a href="@Url.Action("Edit", "Courses", new { id = course.CourseId })" class="btn btn-warning ml-2">Edytuj</a>
                                                <a href="@Url.Action("Delete", "Courses", new { id = course.CourseId })" class="btn btn-danger ml-2">Usuń</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">
                                    <p class="text-muted">Nie udało się pobrać Twoich kursów.</p>
                                </div>
                            }
                        </div>

                        <div class="text-center mt-4">
                            <a asp-controller="Courses" asp-action="Create" class="btn" style="background-color: #E1528C; color: white; padding: 12px 30px; border-radius: 30px; font-size: 24px; font-weight: bold;">Dodaj Kurs</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var triggerTabList = [].slice.call(document.querySelectorAll('#courseTab a'))
        triggerTabList.forEach(function (triggerEl) {
            var tabTrigger = new bootstrap.Tab(triggerEl)

            triggerEl.addEventListener('click', function (event) {
                event.preventDefault()
                tabTrigger.show()
                triggerTabList.forEach(function (el) {
                    el.style.backgroundColor = ''
                    el.style.color = ''
                })
                triggerEl.style.backgroundColor = '#E1528C'
                triggerEl.style.color = 'white'
            })
        })
    </script>
}