@page
@model AuthSystem.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Zaloguj się";
    // Użyj _AuthLayout.cshtml jako układu dla stron Identity
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="login-container">
    <div class="login-box">
        <h2>Zaloguj się teraz</h2>
        <p>Jeśli nie masz konta, <a asp-page="./Register">załóż nowe konto.</a></p>

        <form id="loginForm">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-group">
                <label for="username">Email</label> <input asp-for="Input.Email" class="form-control" id="username" autocomplete="username" aria-required="true" placeholder="name@example.com" style="border-radius:64px;" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group password-container">
                <label for="password">Hasło</label>
                <input asp-for="Input.Password" class="form-control" id="password" autocomplete="current-password" aria-required="true" placeholder="**********" style="border-radius:64px;" />
                <span class="toggle-password" style=""><i class="fa fa-eye"></i></span>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div>
                <button id="login-submit" type="submit" class="btn btn-lg btn-primary" style="background-color:#E1528C; color:white; border:none; border-radius:64px; padding:10px 30px; font-size: 20px;">Zaloguj się</button>
            </div>
            <div class="form-group checkbox-group" style="padding: 20px 0">
                <input class="form-check-input" asp-for="Input.RememberMe" type="checkbox" />
                <label class="form-check-label" asp-for="Input.RememberMe">Zapamiętaj mnie</label>
            </div>

            <p><a asp-page="./ForgotPassword">Nie pamiętasz hasła?</a></p>

        </form>
    </div>
    <div class="login-image"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
   
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("DOMContentLoaded fired - Login.cshtml script started.");

            // Obsługa przełączania widoczności hasła
            document.querySelectorAll(".toggle-password").forEach(button => {
                button.addEventListener("click", function () {
                    let passwordField = this.previousElementSibling;

                    if (passwordField.type === "password") {
                        passwordField.type = "text";
                        this.innerHTML = '<i class="fa fa-eye-slash"></i>';
                    } else {
                        passwordField.type = "password";
                        this.innerHTML = '<i class="fa fa-eye"></i>';
                    }
                });
            });

            // Obsługa formularza logowania
            const loginForm = document.getElementById('loginForm');
            console.log("loginForm element:", loginForm);

            if (loginForm) {
                console.log("loginForm found, adding event listener.");
                loginForm.addEventListener('submit', async (event) => {
                    event.preventDefault(); // Zapobiega domyślnej wysyłce formularza
                    console.log("Form submit event prevented.");

                    const username = loginForm.querySelector('#username').value; // To jest email
                    const password = loginForm.querySelector('#password').value;
                    const errorMessageDiv = document.getElementById('errorMessage');

                    if (errorMessageDiv) {
                        errorMessageDiv.textContent = '';
                    }

                    try {
                        const response = await fetch('/api/auth/login', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            // W AuthController.cs LoginModel ma "Username", więc wysyłamy jako "username"
                            body: JSON.stringify({ username: username, password: password })
                        });

                        console.log("Status odpowiedzi z API logowania:", response.status);

                        if (response.ok) { // Status 2xx
                            const data = await response.json();
                            console.log("Logowanie udane. Dane z serwera:", data);

                            if (data.token) {
                                localStorage.setItem('jwtToken', data.token);
                                console.log("Token JWT zapisany w Local Storage.");
                            }

                            if (data.redirectUrl) {
                                console.log(`Przekierowanie do: ${data.redirectUrl}`);
                                window.location.href = data.redirectUrl; // Przekieruj na stronę główną
                            } else {
                                // Jeśli nie ma redirectUrl, ale ciasteczko zostało ustawione, odśwież stronę
                                console.warn("Logowanie udane, ale brak RedirectUrl. Odświeżanie strony.");
                                window.location.reload();
                            }
                        } else {
                            const errorData = await response.json();
                            const message = errorData.message || response.statusText || 'Nieznany błąd logowania.';
                            if (errorMessageDiv) {
                                errorMessageDiv.textContent = `Błąd logowania: ${message}`;
                            }
                            console.error('Błąd logowania:', response.status, errorData);
                        }
                    } catch (error) {
                        if (errorMessageDiv) {
                            errorMessageDiv.textContent = 'Wystąpił błąd sieciowy lub inny problem.';
                        }
                        console.error('Błąd podczas logowania (catch):', error);
                    }
                });
            } else {
                console.log("loginForm element NOT found on this page.");
            }
        });
    </script>
}
